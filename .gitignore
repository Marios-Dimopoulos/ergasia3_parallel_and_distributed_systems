
· GITIGNORE
# Input matrices used for testing/validation - too large to check into
# git. Store the .mat files you're working with in this directory; the
# bash scripts have this path hard-coded (see README.md).
matrices/
 
# Build output (the Makefile's executables)
/executable_TPN
/executable_WPN
 
# Generic compiled/object artifacts
*.o
*.obj
*.exe
*.a
*.so
*.dylib
 
# Slurm job output/error logs (named "job_<job_id>.out" / "job_<job_id>.err",
# and "matlab_res_<job_id>.out/.err" for the numberOfCC.sh script)
job_*.out
job_*.err
matlab_res_*.out
matlab_res_*.err
 
# Editor / IDE
.vscode/
.idea/
*.swp
*~
 
# OS cruft
.DS_Store
Thumbs.db
 
# Profiling / debugging artifacts
*.dSYM/
core
 
